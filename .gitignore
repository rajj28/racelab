# Secrets. The DSN and AWS credentials live here; .env.example is the template.
.env

# Environments
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Vendored PostgreSQL binaries and their data directory. `scripts/pg_portable.py
# init` recreates both; the zip is ~200 MB and the data directory is machine-
# specific state, so neither belongs in the repo.
vendor/
data/
*.log

# docs/demo.gif IS committed -- it is the first thing a judge sees, it is
# generated from a real run, and a README whose lead image 404s is worse than
# one without an image.
!docs/demo.gif

# Experiment outputs ARE committed. results/*.json holds the raw per-cell
# aggregates that every table in the README and METHODOLOGY is rendered from,
# and `scripts/render_sweep.py` regenerates the reports from them. Ignoring
# them would leave the reports as unverifiable prose.
#
# results/superseded/ is committed too, deliberately: METHODOLOGY entry 10
# discusses the sweep we discarded, and a reader should be able to see what was
# actually thrown away rather than take our description of it on trust. That
# directory carries its own README marking it do-not-cite.

# Build output. The Lambda layer is 23 MB of vendored psycopg wheels rebuilt by
# `pip install --platform manylinux2014_x86_64 --target build/layer/python`;
# deploy/deploy.py documents the command. Vendored dependencies in a repo are
# noise for a reader and drift from what is actually deployed.
build/

# The live demo app. `node_modules` is reinstallable from package.json and
# `dist` is a build artefact that the Dockerfile regenerates -- committing
# either would add tens of thousands of files a reader has to scroll past.
app/node_modules/
app/dist/
