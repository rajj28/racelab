# RaceLab environment.
# Copy to .env and fill in. Never commit .env.

# --- Arm A: PostgreSQL control (READ COMMITTED) -----------------------------
# Local Postgres 16. Docker: `make pg-up` sets this up for you.
RACELAB_PG_DSN=postgresql://racelab:racelab@127.0.0.1:5432/racelab

# --- Arms B and C: CockroachDB (SERIALIZABLE) ------------------------------
# CockroachDB Cloud Basic connection string, from the Cloud console
# ("Connect" -> "General connection string"). Must include sslmode=verify-full
# or sslmode=require.
RACELAB_CRDB_DSN=postgresql://user:password@host:26257/racelab?sslmode=verify-full

# --- Bedrock (Phase 2+: embeddings and reasoning) --------------------------
# Not required for Phase 0 / Phase 1 (the gate uses no LLM).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RACELAB_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
RACELAB_REASON_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
